DATABASE_URL=postgresql://stockmanager:changeme@localhost:5432/stockmanager
PORT=3000
NODE_ENV=development
UPLOADS_DIR=./uploads

# Mail-import: het taalmodel dat inkomende klantmail leest (features/60-mail-import.md §6).
# Zonder sleutel draait alleen de regelmotor — de import blijft gewoon werken,
# alleen minder flexibel bij onbekende pdf-layouts.
ANTHROPIC_API_KEY=
# Optioneel. Standaard claude-opus-5.
MAIL_AI_MODEL=claude-opus-5
# Zet op 'uit' om het meelezen uit te zetten. Let op: er is geen tweede motor
# meer, dus dan levert een gesleepte mail geen regels op.
MAIL_AI=aan
# Tweede, onafhankelijke lezing van dezelfde mail. Waar de twee het eens zijn is
# dat het sterkste signaal dat we hebben. Kost twee keer de invoer-tokens.
MAIL_AI_CONTROLE=aan
# Hoe grondig het model nadenkt: low, medium, high, xhigh of max.
# Het handelsdocument als volledige pdf naar het model (aanbevolen), of terug
# naar alleen de uitgeklopte tekst. Zie features/62-mail-import-ai-ontwerp.md.
MAIL_AI_DOCUMENT=pdf

MAIL_AI_EFFORT=high
