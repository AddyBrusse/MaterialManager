DATABASE_URL=postgresql://stockmanager:changeme@localhost:5432/stockmanager
PORT=3000
NODE_ENV=development
UPLOADS_DIR=./uploads

# Mail-import: het taalmodel dat inkomende klantmail leest (features/60-mail-import.md §6).
# Zonder sleutel draait alleen de regelmotor — de import blijft gewoon werken,
# alleen minder flexibel bij onbekende pdf-layouts.
ANTHROPIC_API_KEY=
# Optioneel. Standaard claude-opus-5.
MAIL_AI_MODEL=claude-opus-5
# Zet op 'uit' om het meelezen tijdelijk uit te zetten zonder de sleutel te wissen.
MAIL_AI=aan
