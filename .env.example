DATABASE_URL=postgresql://stockmanager:changeme@localhost:5432/stockmanager
PORT=3000
NODE_ENV=development
UPLOADS_DIR=./uploads

# De AI-sleutel voor de mail-import en de assistent (features/60-mail-import.md §6).
# Maak hem op platform.claude.com/settings/keys en kies bij de verloopdatum
# "Never": een verlopen sleutel is niet opnieuw te activeren. De server leest hem
# alleen bij het starten, dus na wijzigen herstarten. Of hij werkt staat in
# Instellingen → Bedrijf → AI-sleutel en bij het starten in de console.
# Zonder sleutel levert een gesleepte mail geen regels op en werkt de assistent
# zonder AI. Let op: een Windows-omgevingsvariabele met dezelfde naam gaat voor
# op dit bestand.
ANTHROPIC_API_KEY=
# Optioneel. Standaard claude-opus-5.
MAIL_AI_MODEL=claude-opus-5
# Zet op 'uit' om het meelezen uit te zetten. Let op: er is geen tweede motor
# meer, dus dan levert een gesleepte mail geen regels op.
MAIL_AI=aan
# Tweede, onafhankelijke lezing van dezelfde mail. Waar de twee het eens zijn is
# dat het sterkste signaal dat we hebben. Kost twee keer de invoer-tokens.
MAIL_AI_CONTROLE=aan
# Hoe grondig het model nadenkt: low, medium, high, xhigh of max.
# Het handelsdocument als volledige pdf naar het model (aanbevolen), of terug
# naar alleen de uitgeklopte tekst. Zie features/62-mail-import-ai-ontwerp.md.
MAIL_AI_DOCUMENT=pdf

# Het titelblok van een tekening laten lezen als die op zijn bestandsnaam nergens
# bij past. Kost een tweede aanroep, en gebeurt alleen als er iets te winnen is.
MAIL_AI_TITELBLOK=aan

MAIL_AI_EFFORT=high
