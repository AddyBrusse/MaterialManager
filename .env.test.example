# De testomgeving voor de managers (2026-11-03). Zie tools/test-omgeving/LEESMIJ.md.
#
# `npm run test-omgeving:db -- start` maakt hiervan .env.test in de map van de
# TEST (bv. C:\ShopCommand-test), nooit in de map van de echte app.
# .env.test staat in .gitignore.

# Vult `npm run test-omgeving:db -- start` zelf in, met het wachtwoord van de
# testcontainer. De naam van de database MOET op _test eindigen: anders weigert
# de test-app te starten (slot 1).
DATABASE_URL=postgresql://shopcommand_test:WACHTWOORD@localhost:5433/shopcommand_test

# Maakt dit de test-app: hij start alleen tegen een database die op _test eindigt.
OMGEVING=test

# Gebouwde versie: één proces dat ook de schermen serveert, op een eigen poort.
# Een andere poort dan de echte app = eigen browsergeheugen per adres.
NODE_ENV=production
PORT=3100

# Tekeningen en foto's van de test, los van die van de echte app.
# Relatief aan apps/api, dus apps\api\uploads-test.
UPLOADS_DIR=./uploads-test

# De AI-sleutel (mail-import en assistent). Elke vraag in de test kost ook geld.
# Leeg = zonder AI. Een Windows-variabele ANTHROPIC_API_KEY gaat voor op dit bestand.
ANTHROPIC_API_KEY=
