generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
  // Het account van een machinescherm op de werkvloer, geen persoon. Ziet
  // alleen de kioskroute; wie er staat wordt apart gekozen bij bemand werk.
  terminal
}

enum LocationKind {
  rack
  cabinet
}

enum ItemType {
  raw
  finished
  project
}

enum MovementKind {
  delta
  overwrite
}

enum MovementReason {
  received
  used
  scrapped
  correction
  other
}

enum LabelStatus {
  printed_unused
  consumed
  voided
}

enum TodoPriority {
  low
  normal
  high
}

model Company {
  id               String   @id @default("default")
  naam             String   @default("")
  adres            String?
  postcode         String?
  stad             String?
  land             String   @default("Nederland")
  telefoon         String?
  email            String?
  website          String?
  kvk              String?
  btw              String?
  iban             String?
  graphClientId    String?  @map("graph_client_id")
  graphTenantId    String?  @map("graph_tenant_id")
  // Eigen maildomeinen — nodig om te zien of een binnengehaalde mail is
  // doorgestuurd door een collega in plaats van rechtstreeks van de klant te
  // komen (features/60-mail-import.md §3.2). Een lijst, want bedrijven krijgen
  // er domeinen bij. Leeg = afleiden uit het bedrijfsadres en de gebruikers.
  eigenDomeinen    Json     @default("[]") @map("eigen_domeinen")
  /// Een zaagrestant korter dan dit is geen bruikbaar stuk staal meer en wordt
  /// als schroot afgeboekt; daarboven gaat het terug het rek in. Werkplaatsbreed
  /// omdat het over de voorraad gaat, niet over één machine.
  schrootDrempelMm Int      @default(200) @map("schroot_drempel_mm")
  /// Na zoveel dagen zonder reactie telt een verstuurde offerte als "nabellen"
  /// op het projectenoverzicht.
  offerteNabelDagen Int     @default(21) @map("offerte_nabel_dagen")
  /// Inkoop: zoveel werkdagen eerder binnen dan de productie het nodig heeft
  /// (2026-10-07). "Uiterlijk bestellen" = nodig − levertijd − deze marge.
  inkoopMargeDagen Int      @default(2) @map("inkoop_marge_dagen")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("company")
}

model User {
  id         String   @id @default(uuid())
  name       String   @unique
  achternaam String?
  titel      String?
  email      String?  @unique
  telefoon   String?
  role       Role     @default(user)
  avatarPath String?  @map("avatar_path")
  /// Alleen voor rol 'terminal': aan welke machine dit scherm hangt. De
  /// wachtrij liep hiervoor op accountnaam, en dan moest die naam exact gelijk
  /// zijn aan wat er op de productiestap staat — noemde de stap "Draaibank" en
  /// het account "DMG 450TC EcoLine", dan bleef het scherm leeg terwijl er werk
  /// lag. Een verwijzing kan niet uit de pas lopen met een hernoeming.
  machineId  String?  @map("machine_id")
  createdAt  DateTime @default(now()) @map("created_at")

  movements        StockMovement[]
  locks            Lock[]
  lockRequests     LockRequest[]
  labels           Label[]
  createdTodos     Todo[]            @relation("TodoCreatedBy")
  claimedTodos     Todo[]            @relation("TodoClaimedBy")
  preferences      UserPreference[]
  tijdregistraties TijdRegistratie[]
  machine          Machine?          @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@map("users")
}

// Per-user UI preferences, stored as a generic key → JSON blob so new
// preference kinds don't each need a migration. First use: the projecten
// table's column order / visibility / colours ('projects.table').
model UserPreference {
  userId    String   @map("user_id")
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_preferences")
}

model Location {
  id        String       @id @default(uuid())
  kind      LocationKind
  label     String
  createdAt DateTime     @default(now()) @map("created_at")

  slots LocationSlot[]

  @@map("locations")
}

model LocationSlot {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  level1     String
  level2     String?
  createdAt  DateTime @default(now()) @map("created_at")

  location      Location       @relation(fields: [locationId], references: [id])
  rawMaterials  RawMaterial[]
  finishedGoods FinishedGood[]

  @@map("location_slots")
}

model Grade {
  id          String   @id @default(uuid())
  name        String   @unique
  densityKgM3 Decimal  @map("density_kg_m3")
  pricePerKg  Decimal? @map("price_per_kg")
  createdAt   DateTime @default(now()) @map("created_at")

  rawMaterials RawMaterial[]
  leveranciersprijzen LeverancierPrijs[]
  bestelRegels BestelRegel[]

  @@map("grades")
}

model Profile {
  id              String   @id @default(uuid())
  name            String
  dimensionSchema Json     @map("dimension_schema")
  volumeFormula   String   @map("volume_formula")
  createdAt       DateTime @default(now()) @map("created_at")

  rawMaterials RawMaterial[]
  bestelRegels BestelRegel[]

  @@map("profiles")
}

model SurfaceFinish {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  rawMaterials RawMaterial[]

  @@map("surface_finishes")
}

model RawMaterial {
  id              String   @id @default(uuid())
  code            String   @unique
  gradeId         String   @map("grade_id")
  profileId       String   @map("profile_id")
  surfaceFinishId String?  @map("surface_finish_id")
  dimensions      Json
  lengthMm        Decimal  @map("length_mm")
  locationSlotId  String?  @map("location_slot_id")
  photoPath       String?  @map("photo_path")
  minStock        Decimal? @map("min_stock")
  currentStock    Decimal  @default(0) @map("current_stock")
  /// Exoot (2026-10-06): materiaal buiten het vaste assortiment, op maat gezaagd
  /// door de leverancier en voor één klant (bv. Alu 6082 plaat 250 × 300 × 30).
  /// Staat gewoon in de materiaallijst, met een label.
  exoot           Boolean  @default(false)
  klantId         String?  @map("klant_id")
  artikelId       String?  @map("artikel_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  grade          Grade          @relation(fields: [gradeId], references: [id])
  klant          Relatie?       @relation("ExootKlant", fields: [klantId], references: [id], onDelete: SetNull)
  artikel        Article?       @relation("ExootArtikel", fields: [artikelId], references: [id], onDelete: SetNull)
  leveranciersprijzen LeverancierPrijs[]
  bestelRegels   BestelRegel[]
  profile        Profile        @relation(fields: [profileId], references: [id])
  surfaceFinish  SurfaceFinish? @relation(fields: [surfaceFinishId], references: [id])
  locationSlot   LocationSlot?  @relation(fields: [locationSlotId], references: [id])
  consumingLabel Label?         @relation("LabelConsumedMaterial")

  @@map("raw_materials")
}

model FinishedGood {
  id             String   @id @default(uuid())
  artNo          String   @unique @map("art_no")
  name           String
  customer       String?
  photoPath      String?  @map("photo_path")
  drawingPath    String?  @map("drawing_path")
  locationSlotId String?  @map("location_slot_id")
  minStock       Decimal? @map("min_stock")
  currentStock   Decimal  @default(0) @map("current_stock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  locationSlot LocationSlot? @relation(fields: [locationSlotId], references: [id])

  @@map("finished_goods")
}

model StockMovement {
  id            String         @id @default(uuid())
  itemType      ItemType       @map("item_type")
  itemId        String         @map("item_id")
  userId        String         @map("user_id")
  kind          MovementKind
  amount        Decimal
  previousStock Decimal        @map("previous_stock")
  newStock      Decimal        @map("new_stock")
  reason        MovementReason
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("stock_movements")
}

model Label {
  number                String      @id
  batchId               String      @map("batch_id")
  status                LabelStatus
  printedAt             DateTime    @map("printed_at")
  printedById           String      @map("printed_by")
  consumedAt            DateTime?   @map("consumed_at")
  consumedRawMaterialId String?     @unique @map("consumed_raw_material_id")

  printedBy           User         @relation(fields: [printedById], references: [id])
  consumedRawMaterial RawMaterial? @relation("LabelConsumedMaterial", fields: [consumedRawMaterialId], references: [id])

  @@index([status])
  @@map("labels")
}

model Lock {
  itemType      ItemType @map("item_type")
  itemId        String   @map("item_id")
  userId        String   @map("user_id")
  acquiredAt    DateTime @map("acquired_at")
  lastHeartbeat DateTime @map("last_heartbeat")

  user User @relation(fields: [userId], references: [id])

  @@id([itemType, itemId])
  @@index([lastHeartbeat])
  @@map("locks")
}

model LockRequest {
  id             String    @id @default(uuid())
  itemType       ItemType  @map("item_type")
  itemId         String    @map("item_id")
  requestedById  String    @map("requested_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  requestedBy User @relation(fields: [requestedById], references: [id])

  @@map("lock_requests")
}

// ── Business entity models ────────────────────────────────────────────────────

model Machine {
  id                  String  @id @default(uuid())
  name                String
  machineRatePerHour  Decimal @map("machine_rate_per_hour")
  operatorRatePerHour Decimal @map("operator_rate_per_hour")
  defaultSetupMin     Int     @map("default_setup_min")
  worksWeekends       Boolean @default(false) @map("works_weekends")

  // Stangenlader en opspanning. Deze horen bij de draaibank en niet bij de
  // zaagbon: de DMG en de Doosan kunnen een andere stanglengte aan. Per zaagbon
  // mag ervan afgeweken worden, zoals dat nu al met kerf en vlaktoeslag gaat.
  barloaderMinMm Int @default(500) @map("barloader_min_mm")
  barloaderMaxMm Int @default(1100) @map("barloader_max_mm")
  /// Staartje dat de lader niet meer kan pakken — per laderstang één keer weg.
  opspanlengteMm Int @default(30) @map("opspanlengte_mm")
  /// Wat de afsteekbeitel per stuk wegneemt.
  afsteekMm      Int @default(3) @map("afsteek_mm")
  /// Draaibank met stangenlader (2026-10-06). Alleen dan rekent de calculatie
  /// afsteek en opspanstukje mee in de bruto lengte (`bruto-lengte.ts`).
  heeftStangenlader Boolean @default(false) @map("heeft_stangenlader")
  /// Wat voor werk (2026-10-08): zagen | draaien | frezen | handwerk | uitbesteed.
  /// De planning sleept een stap alleen naar een machine van dezelfde soort.
  soort             String?

  createdAt DateTime @default(now()) @map("created_at")

  /// Terminalschermen die aan deze machine hangen.
  terminals User[]

  @@map("machines")
}

model Relatie {
  id                 String   @id @default(uuid())
  naam               String
  type               String
  actief             Boolean  @default(true)
  telefoon           String?
  email              String?
  emailFactuur       String?  @map("email_factuur")
  emailOfferte       String?  @map("email_offerte")
  website            String?
  straat             String?
  postcode           String?
  stad               String?
  land               String   @default("Nederland")
  factuurAdresZelfde Boolean  @default(true) @map("factuur_adres_zelfde")
  factuurStraat      String?  @map("factuur_straat")
  factuurPostcode    String?  @map("factuur_postcode")
  factuurStad        String?  @map("factuur_stad")
  factuurLand        String?  @map("factuur_land")
  afleverAdresZelfde Boolean  @default(true) @map("aflever_adres_zelfde")
  afleverStraat      String?  @map("aflever_straat")
  afleverPostcode    String?  @map("aflever_postcode")
  afleverStad        String?  @map("aflever_stad")
  afleverLand        String?  @map("aflever_land")
  kvk                String?
  btw                String?
  iban               String?
  betalingstermijn   Int?
  notities           String?
  contacten          Json     @default("[]")
  /// Leverancier: vanaf dit orderbedrag geen verzendkosten (2026-10-07).
  /// Daaronder wachten we liever op meer regels, zolang de planning het toelaat.
  francoBedrag       Decimal? @map("franco_bedrag")
  createdAt          DateTime @default(now()) @map("created_at")

  exoten             RawMaterial[]      @relation("ExootKlant")
  prijzen            LeverancierPrijs[]
  bestelKeuzes       BestelRegel[]      @relation("BestelKeuze")
  aanvragen          PrijsaanvraagLeverancier[] @relation("AanvraagLeverancier")
  antwoorden         PrijsaanvraagAntwoord[]    @relation("AanvraagAntwoord")
  inkooporders       Inkooporder[]              @relation("InkoopLeverancier")

  @@map("relaties")
}

model Article {
  id           String   @id
  naam         String
  klant        String?
  relatieId    String?  @map("relatie_id")
  contactId    String?  @map("contact_id")
  tekening     String?
  rev          String?
  drawingPath  String?  @map("drawing_path")
  photoPath    String?  @map("photo_path")
  recipe       Json?
  operations   Json     @default("[]")
  notes        Json     @default("{\"workholding\":\"\",\"general\":\"\"}")
  attachments  Json     @default("[]")
  estimate     Json?
  locatie      String?
  currentStock Decimal  @default(0) @map("current_stock")
  minStock     Decimal? @map("min_stock")
  maxStock     Decimal? @map("max_stock")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reserveringen  ZaagReservering[]
  prijsSnapshots ArtikelPrijsSnapshot[]
  exoten         RawMaterial[] @relation("ExootArtikel")

  @@map("articles")
}

/// Prijshistorie van een artikel: één rij per meetmoment.
///
/// Twee bronnen in één tabel, onderscheiden door `bron`, zodat het scherm er
/// één lijn van kan maken:
///   'order'      — een offerte is geaccepteerd, dit is wat de klant betaalt
///                  bij dit aantal, met de kostprijs van dat moment ernaast.
///   'calculatie' — het recept is opgeslagen en de kostprijs veranderde.
///
/// Alles per stuk EN per order, want zonder aantal is een prijs per stuk niet
/// te lezen: insteltijd wordt over de batch verdeeld.
model ArtikelPrijsSnapshot {
  id        String   @id @default(uuid())
  artikelId String   @map("artikel_id")
  bron      String
  gemetenOp DateTime @map("gemeten_op")

  qty                 Float
  kostprijsPerStuk    Float  @map("kostprijs_per_stuk")
  // Kostprijs en calculatie-verkoopprijs herrekend bij 1 stuk. Dit is de enige
  // vergelijkbare maat over de tijd: `kostprijsPerStuk` hangt aan het aantal
  // van dát moment (insteltijd wordt over de batch verdeeld), dus een order van
  // 10 zou de lijn laten kelderen zonder dat er iets goedkoper geworden is.
  kostprijsBasis      Float  @map("kostprijs_basis")
  verkoopprijsBasis   Float  @map("verkoopprijs_basis")
  verkoopprijsPerStuk Float? @map("verkoopprijs_per_stuk")
  margePct            Float? @map("marge_pct")
  kostprijsTotaal     Float  @map("kostprijs_totaal")
  verkoopprijsTotaal  Float? @map("verkoopprijs_totaal")

  // Opbouw per stuk, bij dit aantal. Zonder deze vier zie je later wel dát de
  // kostprijs steeg, maar niet of het het materiaal was of het uurtarief.
  materiaalPerStuk Float @map("materiaal_per_stuk")
  instellenPerStuk Float @map("instellen_per_stuk")
  bewerkingPerStuk Float @map("bewerking_per_stuk")
  externPerStuk    Float @map("extern_per_stuk")

  projectId      String?  @map("project_id")
  offerteId      String?  @map("offerte_id")
  offerteRegelId String?  @map("offerte_regel_id")
  relatieId      String?  @map("relatie_id")
  klant          String?
  door           String?
  createdAt      DateTime @default(now()) @map("created_at")

  artikel Article @relation(fields: [artikelId], references: [id], onDelete: Cascade)

  @@index([artikelId, gemetenOp])
  @@map("artikel_prijs_snapshots")
}

model DocSequence {
  prefix String @id
  lastN  Int    @default(0) @map("last_n")

  @@map("doc_sequences")
}

/// Handmatige wijziging van een nummerreeks (Instellingen → Nummering,
/// 2026-10-05). Wie, wanneer, van welk volgend nummer naar welk, en waarom —
/// zodat een gat in de factuurnummers later te verklaren is.
model DocReeksWijziging {
  id        String   @id @default(uuid())
  sleutel   String   // bv. FACT-2026
  van       Int      // het volgende nummer vóór de wijziging
  naar      Int      // het volgende nummer erna
  reden     String
  door      String   // naam van de gebruiker op het moment van wijzigen
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("doc_reeks_wijzigingen")
}

/// Prijs van een leverancier (2026-10-06), voor één materiaal óf voor een hele
/// kwaliteit ("alle Alu 6082 € 7,20/kg"). Gebruikt bij vergelijken en bestellen;
/// de calculatie rekent met de €/kg van de kwaliteit. Per stuk alleen bij een
/// materiaal: zonder maat zegt een stuksprijs niets.
model LeverancierPrijs {
  id                 String   @id @default(uuid())
  leverancierId      String   @map("leverancier_id")
  rawMaterialId      String?  @map("raw_material_id")
  gradeId            String?  @map("grade_id")
  /// 'per_kg' | 'per_stuk'
  prijsSoort         String   @map("prijs_soort")
  prijs              Decimal
  zaagkostenPerSnede Decimal? @map("zaagkosten_per_snede")
  minimumBedrag      Decimal? @map("minimum_bedrag")
  levertijdDagen     Int?     @map("levertijd_dagen")
  notitie            String?
  bijgewerktDoor     String?  @map("bijgewerkt_door")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  leverancier Relatie      @relation(fields: [leverancierId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  grade       Grade?       @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([rawMaterialId])
  @@index([gradeId])
  @@index([leverancierId])
  @@map("leverancier_prijzen")
}

// Inkoop (2026-10-06). Een bestelregel gaat over een maat — kwaliteit, vorm,
// afmeting, lengte × stuks — niet over een staaf; die bestaat pas als hij
// binnen is. Een exoot wijst naar zijn eigen regel in de materiaallijst.
// projectId/artikelId/offerteRegelId zijn losse verwijzingen, net als bij
// todo's: een bestelling blijft staan als het project weg is.
model BestelRegel {
  id             String   @id @default(uuid())
  /// 'te_bestellen' | 'aangevraagd' | 'buffer' | 'besteld' | 'ontvangen'.
  /// Gaat vooruit; alleen uit de buffer mag hij terug (vóór er besteld is).
  status         String   @default("te_bestellen")
  /// 'opdracht_exoot' | 'tekort' | 'handmatig' | 'lage_voorraad'
  bron           String
  gradeId        String   @map("grade_id")
  profileId      String   @map("profile_id")
  dimensions     Json
  lengteMm       Decimal  @map("lengte_mm")
  stuks          Int
  rawMaterialId  String?  @map("raw_material_id")
  projectId      String?  @map("project_id")
  artikelId      String?  @map("artikel_id")
  offerteRegelId String?  @map("offerte_regel_id")
  notitie        String?
  /// Bij wie we een prijs vragen (tab Te bestellen, 2026-10-07).
  leverancierIds String[] @default([]) @map("leverancier_ids")
  // De keuze, met de prijs zoals die was bij het kiezen: een inkooporder mag
  // niet meeschuiven als iemand later de prijslijst bijwerkt.
  keuzeLeverancierId  String?   @map("keuze_leverancier_id")
  /// 'prijslijst' | 'antwoord'
  keuzeBron           String?   @map("keuze_bron")
  keuzeAntwoordId     String?   @map("keuze_antwoord_id")
  keuzeTotaal         Decimal?  @map("keuze_totaal")
  keuzeUitleg         String?   @map("keuze_uitleg")
  keuzeLevertijdDagen Int?      @map("keuze_levertijd_dagen")
  keuzeOp             DateTime? @map("keuze_op")
  keuzeDoor           String?   @map("keuze_door")
  toegevoegdDoor String   @map("toegevoegd_door")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  grade            Grade        @relation(fields: [gradeId], references: [id])
  profile          Profile      @relation(fields: [profileId], references: [id])
  rawMaterial      RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  keuzeLeverancier Relatie?     @relation("BestelKeuze", fields: [keuzeLeverancierId], references: [id], onDelete: SetNull)
  aanvragen        PrijsaanvraagRegel[]
  antwoorden       PrijsaanvraagAntwoord[]
  inkoopRegels     InkooporderRegel[]

  @@index([status])
  @@index([projectId])
  @@map("bestel_regels")
}

/// PA-2026-001: één aanvraag aan één of meer leveranciers, elk met een eigen mail.
model Prijsaanvraag {
  id        String   @id
  notitie   String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  regels       PrijsaanvraagRegel[]
  leveranciers PrijsaanvraagLeverancier[]
  antwoorden   PrijsaanvraagAntwoord[]

  @@map("prijsaanvragen")
}

model PrijsaanvraagRegel {
  prijsaanvraagId String @map("prijsaanvraag_id")
  bestelRegelId   String @map("bestel_regel_id")

  prijsaanvraag Prijsaanvraag @relation(fields: [prijsaanvraagId], references: [id], onDelete: Cascade)
  bestelRegel   BestelRegel   @relation(fields: [bestelRegelId], references: [id], onDelete: Cascade)

  @@id([prijsaanvraagId, bestelRegelId])
  @@map("prijsaanvraag_regels")
}

model PrijsaanvraagLeverancier {
  prijsaanvraagId String    @map("prijsaanvraag_id")
  leverancierId   String    @map("leverancier_id")
  /// Pas gezet na "Ja, verstuurd" — een klaargezette mail is nog niet verstuurd.
  verzondenOp     DateTime? @map("verzonden_op")
  verzondenDoor   String?   @map("verzonden_door")

  prijsaanvraag Prijsaanvraag @relation(fields: [prijsaanvraagId], references: [id], onDelete: Cascade)
  leverancier   Relatie       @relation("AanvraagLeverancier", fields: [leverancierId], references: [id], onDelete: Cascade)

  @@id([prijsaanvraagId, leverancierId])
  @@map("prijsaanvraag_leveranciers")
}

model PrijsaanvraagAntwoord {
  id                 String   @id @default(uuid())
  prijsaanvraagId    String   @map("prijsaanvraag_id")
  bestelRegelId      String   @map("bestel_regel_id")
  leverancierId      String   @map("leverancier_id")
  /// 'per_kg' | 'per_stuk' | 'totaal'
  prijsSoort         String   @map("prijs_soort")
  prijs              Decimal
  zaagkostenPerSnede Decimal? @map("zaagkosten_per_snede")
  levertijdDagen     Int?     @map("levertijd_dagen")
  notitie            String?
  bijgewerktDoor     String?  @map("bijgewerkt_door")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  prijsaanvraag Prijsaanvraag @relation(fields: [prijsaanvraagId], references: [id], onDelete: Cascade)
  bestelRegel   BestelRegel   @relation(fields: [bestelRegelId], references: [id], onDelete: Cascade)
  leverancier   Relatie       @relation("AanvraagAntwoord", fields: [leverancierId], references: [id], onDelete: Cascade)

  @@unique([prijsaanvraagId, bestelRegelId, leverancierId])
  @@index([bestelRegelId])
  @@map("prijsaanvraag_antwoorden")
}

/// INK-2026-001 (2026-10-06, deel 3b). Verstuurd ligt vast; intrekken maakt hem
/// vervallen (met reden) en zet de regels terug, het nummer blijft bestaan.
model Inkooporder {
  id             String    @id
  leverancierId  String    @map("leverancier_id")
  /// 'concept' | 'verzonden' | 'vervallen'
  status         String    @default("concept")
  notitie        String?
  verzondenOp    DateTime? @map("verzonden_op")
  verzondenDoor  String?   @map("verzonden_door")
  vervallenOp    DateTime? @map("vervallen_op")
  vervallenReden String?   @map("vervallen_reden")
  vervallenDoor  String?   @map("vervallen_door")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  leverancier Relatie            @relation("InkoopLeverancier", fields: [leverancierId], references: [id])
  regels      InkooporderRegel[]

  @@index([status])
  @@map("inkooporders")
}

/// De prijs zoals hij bij "Kies" werd vastgelegd, overgenomen op de order.
model InkooporderRegel {
  id             String   @id @default(uuid())
  inkooporderId  String   @map("inkooporder_id")
  bestelRegelId  String   @map("bestel_regel_id")
  positie        Int
  stuks          Int
  lengteMm       Decimal  @map("lengte_mm")
  totaal         Decimal
  uitleg         String
  levertijdDagen Int?     @map("levertijd_dagen")
  ontvangenStuks Int      @default(0) @map("ontvangen_stuks")
  /// 260042 (2026-10-07, jaar + volgnummer): ons nummer, dat de leverancier op het materiaal
  /// plakt. Bij binnen boeken typ je het in; het stuk in de voorraad krijgt
  /// hetzelfde nummer (met -1, -2 bij meer stuks).
  materiaalNummer String? @unique @map("materiaal_nummer")
  /// Leverdatum zoals de leverancier hem doorgaf ('YYYY-MM-DD'). Leeg =
  /// verstuurd + levertijd in werkdagen, afgeleid bij het lezen.
  verwachtDatum      String?   @map("verwacht_datum")
  verwachtAangepastOp   DateTime? @map("verwacht_aangepast_op")
  verwachtAangepastDoor String?   @map("verwacht_aangepast_door")

  inkooporder Inkooporder @relation(fields: [inkooporderId], references: [id], onDelete: Cascade)
  bestelRegel BestelRegel @relation(fields: [bestelRegelId], references: [id], onDelete: Restrict)
  ontvangsten Ontvangst[]

  @@index([bestelRegelId])
  @@map("inkooporder_regels")
}

/// Eén keer iets binnen; de staven die het werden staan in `codes`.
model Ontvangst {
  id                 String   @id @default(uuid())
  inkooporderRegelId String   @map("inkooporder_regel_id")
  stuks              Int
  rawMaterialIds     Json     @default("[]") @map("raw_material_ids")
  codes              Json     @default("[]")
  gereserveerdVoor   String?  @map("gereserveerd_voor")
  notitie            String?
  door               String
  createdAt          DateTime @default(now()) @map("created_at")

  regel InkooporderRegel @relation(fields: [inkooporderRegelId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@map("ontvangsten")
}

// Het project is de kop: klant, referentie, status. De documenten die eraan
// hangen (offerte, opdrachtbevestiging, productieorders, paklijst, factuur)
// staan in eigen tabellen — zie de beslissing van 2026-09-09 in
// decisions/90-decisions-log.md. De API levert ze nog steeds als één genest
// Project op; alleen de opslag is genormaliseerd.
model Project {
  id             String   @id
  naam           String
  relatieId      String?  @map("relatie_id")
  contactId      String?  @map("contact_id")
  klantRef       String?  @map("klant_ref")
  status         String   @default("concept")
  levertijdDatum String?  @map("levertijd_datum")
  notities       String   @default("")
  // Alleen gevuld bij on_hold en geannuleerd: waarom, en waar het project
  // vandaan kwam zodat hervatten naar precies die stap terugkeert.
  statusReden    String?  @map("status_reden")
  statusVorige   String?  @map("status_vorige")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  offertes            Offerte[]
  opdrachtbevestiging Opdrachtbevestiging?
  productieOrders     ProductieOrder[]
  /// Voor "wacht op materiaal" op de productieorder (afgeleid bij het lezen).
  bestelRegels        BestelRegel[]
  paklijsten          Paklijst[]
  facturen            Factuur[]
  reserveringen       ZaagReservering[]

  @@map("projects")
}

// ── Offerte ───────────────────────────────────────────────────────────────────

model Offerte {
  id             String   @id // OFF-YYYY-NNN, uniek per versie
  /// Het nummer dat de klant ziet. Versies van dezelfde offerte delen dit; het
  /// id kan dat niet zijn, want dat is de primary key. Bestaande rijen dragen
  /// hier hun eigen id — die nummers liggen mogelijk al bij een klant.
  documentNr     String   @map("document_nr")
  projectId      String   @map("project_id")
  versie         Int
  status         String   @default("concept")
  notities       String   @default("")
  /// Waar deze versie antwoord op geeft (RFQ-nummer, "mail 12-09"). Vrije tekst.
  externeRef     String?  @map("externe_ref")
  /// Directe opdracht: meteen geaccepteerd, nooit als offerte verstuurd.
  direct         Boolean  @default(false)
  /// 'acceptatie' | 'intrekken' — waarom de versie vervallen is.
  vervallenDoor  String?  @map("vervallen_door")
  geldigTot      String?  @map("geldig_tot")
  verzondenOp    String?  @map("verzonden_op")
  geaccepteerdOp String?  @map("geaccepteerd_op")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regels  OfferteRegel[]

  @@index([projectId])
  @@index([status])
  @@index([documentNr])
  @@map("offertes")
}

// Bevroren momentopname: de regel houdt naam, prijs en bewerkingen vast zoals
// ze golden toen de offerte gemaakt werd, ook als het artikel daarna verandert.
model OfferteRegel {
  id           String   @id
  offerteId    String   @map("offerte_id")
  sortOrder    Int      @map("sort_order")
  artikelId    String?  @map("artikel_id")
  naam         String
  omschrijving String   @default("")
  qty          Float
  eenheid      String
  verkoopprijs Float
  totaal       Float
  bewerkingen  String[] @default([])

  offerte Offerte @relation(fields: [offerteId], references: [id], onDelete: Cascade)

  @@index([offerteId])
  @@map("offerte_regels")
}

// ── Opdrachtbevestiging ───────────────────────────────────────────────────────

model Opdrachtbevestiging {
  id             String   @id // OB-YYYY-NNN
  projectId      String   @unique @map("project_id")
  offerteId      String   @map("offerte_id")
  levertijdDatum String?  @map("levertijd_datum")
  notities       String   @default("")
  /// Waarmee de klant opdracht gaf (inkoopnummer, mail, appje). Vrije tekst.
  opdrachtRef    String?  @map("opdracht_ref")
  status         String   @default("concept")
  verzondenOp    String?  @map("verzonden_op")
  /// Elke keer verstuurd, met wat de klant toen kreeg — zie ObVerzendingSchema.
  verzendingen   Json     @default("[]")
  /// Wijzigingen na acceptatie — zie ObWijzigingSchema.
  wijzigingen    Json     @default("[]")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regels  ObRegel[]

  @@map("opdrachtbevestigingen")
}

model ObRegel {
  id           String   @id
  obId         String   @map("ob_id")
  sortOrder    Int      @map("sort_order")
  artikelId    String?  @map("artikel_id")
  naam         String
  omschrijving String   @default("")
  qty          Float
  eenheid      String
  verkoopprijs Float
  totaal       Float
  bewerkingen  String[] @default([])

  ob Opdrachtbevestiging @relation(fields: [obId], references: [id], onDelete: Cascade)

  @@index([obId])
  @@map("ob_regels")
}

// ── Productie ─────────────────────────────────────────────────────────────────

model ProductieOrder {
  id             String   @id // PROD-YYYY-NNN
  projectId      String   @map("project_id")
  offerteRegelId String   @map("offerte_regel_id")
  artikelId      String?  @map("artikel_id")
  artikelNaam    String   @map("artikel_naam")
  qty            Float
  eenheid        String
  /// Hoeveel stuks er werkelijk klaar zijn. Een order was eerder óf gereed óf
  /// niet, en dan is "34 van de 40" niet vast te houden — terwijl daar de
  /// deellevering op wacht. De operator vult het in bij het gereedmelden.
  aantalGereed   Float    @default(0) @map("aantal_gereed")
  status         String   @default("gepland")
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stappen ProductieStap[]

  @@index([projectId])
  @@index([status])
  @@map("productie_orders")
}

// De wachtrij van een machine loopt dwars door projecten heen, dus staat de
// planning (geplandDatum, geplandMachine, queuePosition) hier en niet bij het
// project. queuePosition is een breukgetal zodat invoegen tussen twee buren
// alleen deze stap raakt.
model ProductieStap {
  id             String  @id
  orderId        String  @map("order_id")
  volgorde       Int
  naam           String
  machine        String?
  gereedOp       String? @map("gereed_op")
  gereedDoor     String? @map("gereed_door")
  geplandDatum   String? @map("gepland_datum")
  geplandMachine String? @map("gepland_machine")
  queuePosition  Float?  @map("queue_position")
  /// Rang uit het automatisch plannen (lager = eerder). Los van queuePosition:
  /// dat is de volgorde die er op de machine uitkomt (2026-10-08).
  prioriteit     Float?
  /// "Machine laten wachten" (2026-10-09): geen ander werk in de tijd vóór
  /// deze stap op zijn machine. Geldt tot de stap gestart is.
  machineWacht   Boolean @default(false) @map("machine_wacht")

  order            ProductieOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tijdregistraties TijdRegistratie[]

  @@index([orderId])
  @@index([geplandMachine, queuePosition])
  @@map("productie_stappen")
}

/// Eén rij per keer dat er een klok op een productiestap loopt.
///
/// De indeling spiegelt `computeEstimateTotals` met opzet: instellen telt één
/// keer per batch, draaien per stuk. Meten we die twee niet apart, dan valt
/// geschat en werkelijk achteraf niet te vergelijken en is de nacalculatie een
/// tabel zonder betekenis.
model TijdRegistratie {
  id          String  @id @default(uuid())
  stapId      String  @map("stap_id")
  orderId     String  @map("order_id")
  projectId   String  @map("project_id")
  // Gedenormaliseerd, zodat de nacalculatie per artikel over alle orders heen
  // te maken is zonder elke keer via order → offerteregel te hoeven lopen.
  artikelId   String? @map("artikel_id")
  artikelNaam String  @map("artikel_naam")

  soort  String // 'instellen' | 'draaien'
  bemand Boolean @default(true)
  status String  @default("lopend") // lopend | gepauzeerd | afgerond

  machineNaam String? @map("machine_naam")
  userId      String? @map("user_id")
  userNaam    String? @map("user_naam")

  gestartOp   DateTime  @map("gestart_op")
  /// Begin van de lopende deelmeting. Gevuld = de klok telt door. Zo overleeft
  /// een lopende klok een herstart van de server zonder tijd te verzinnen.
  lopendSinds DateTime? @map("lopend_sinds")
  gestoptOp   DateTime? @map("gestopt_op")

  /// Opgeteld over alle deelmetingen, exclusief de lopende.
  gemetenSeconden Int @default(0) @map("gemeten_seconden")

  /// De gemeten waarde blijft altijd staan naast de correctie: het verschil
  /// tussen wat de klok zag en wat een mens ervan maakte is zelf een signaal.
  bijgesteldeSeconden Int?      @map("bijgestelde_seconden")
  correctieReden      String?   @map("correctie_reden")
  correctieDoor       String?   @map("correctie_door")
  correctieOp         DateTime? @map("correctie_op")

  aantalStuks Int?    @map("aantal_stuks")
  notitie     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stap ProductieStap @relation(fields: [stapId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([stapId])
  @@index([projectId])
  // De nacalculatie per artikel leest hier op; afgeronde regels zijn wat telt.
  @@index([artikelId, status])
  // "Wat loopt er nu" is de vraag die elke 5 seconden gesteld wordt.
  @@index([status, gestartOp])
  @@map("tijdregistraties")
}

// ── Paklijst ──────────────────────────────────────────────────────────────────

model Paklijst {
  id          String   @id // PL-YYYY-NNN
  projectId   String   @map("project_id")
  notities    String   @default("")
  verzondenOp String?  @map("verzonden_op")
  createdAt   DateTime @map("created_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regels  PaklijstRegel[]

  @@index([projectId])
  @@map("paklijsten")
}

model PaklijstRegel {
  id               String  @id
  paklijstId       String  @map("paklijst_id")
  sortOrder        Int     @map("sort_order")
  productieOrderId String  @map("productie_order_id")
  /// Bij welke orderregel dit hoort. Af te leiden via de productieorder, maar
  /// dan verdwijnt het geleverde aantal zodra die order weg is — en een
  /// verstuurde pakbon hoort niet van gedachten te veranderen.
  offerteRegelId   String? @map("offerte_regel_id")
  artikelNaam      String  @map("artikel_naam")
  qty              Float
  eenheid          String

  paklijst Paklijst @relation(fields: [paklijstId], references: [id], onDelete: Cascade)

  @@index([paklijstId])
  @@index([offerteRegelId])
  @@map("paklijst_regels")
}

// ── Factuur ───────────────────────────────────────────────────────────────────

model Factuur {
  id            String   @id // FACT-YYYY-NNN of CRED-YYYY-NNN
  /// Een credit is geen negatieve factuur maar een eigen document: de factuur
  /// die hij crediteert is verstuurd en blijft staan, de credit telt ernaast.
  soort         String   @default("factuur")
  projectId     String   @map("project_id")
  offerteId     String   @map("offerte_id")
  btwPct        Float    @map("btw_pct")
  subtotaal     Float
  btwBedrag     Float    @map("btw_bedrag")
  totaalInclBtw Float    @map("totaal_incl_btw")
  notities      String   @default("")
  vervaldatum   String?
  verzondenOp   String?  @map("verzonden_op")
  /// Aan wie hij ging; vaak administratie@… in plaats van de contactpersoon.
  naarEmail     String?  @map("naar_email")
  /// Wanneer hij betaald is; null = nog open.
  betaaldOp     String?  @map("betaald_op")
  createdAt     DateTime @map("created_at")

  crediteertFactuurId String? @map("crediteert_factuur_id")

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  regels     FactuurRegel[]
  crediteert Factuur?       @relation("FactuurCredit", fields: [crediteertFactuurId], references: [id], onDelete: SetNull)
  credits    Factuur[]      @relation("FactuurCredit")

  @@index([projectId])
  @@index([verzondenOp])
  @@index([soort])
  @@map("facturen")
}

model FactuurRegel {
  id             String @id
  factuurId      String @map("factuur_id")
  sortOrder      Int    @map("sort_order")
  offerteRegelId String @map("offerte_regel_id")
  naam           String
  qty            Float
  eenheid        String
  verkoopprijs   Float
  totaal         Float

  factuur Factuur @relation(fields: [factuurId], references: [id], onDelete: Cascade)

  @@index([factuurId])
  @@map("factuur_regels")
}

model ZaagReservering {
  id             String    @id
  // Vrij tekstveld dat een zaagbon groepeert; blijft bestaan naast de koppeling
  // hieronder, want er wordt ook gezaagd voor werk dat geen project is.
  calculatieNr   String    @map("calculatie_nr")
  // Waar dit materiaal voor vastligt. Beide optioneel — zie de migratie van
  // 2026-09-09 en de beslissing in decisions/90-decisions-log.md.
  projectId      String?   @map("project_id")
  artikelId      String?   @map("artikel_id")
  /// Voor welke orderregel. Zonder dit is materiaal alleen per artikel te
  /// vinden, en tonen twee regels met hetzelfde artikel dezelfde staaf.
  offerteRegelId String?   @map("offerte_regel_id")
  barId          String    @map("bar_id")
  barCode        String    @map("bar_code")
  barLocation    String    @map("bar_location")
  barVorm        String    @map("bar_vorm")
  pieces         Int
  productLen     Decimal   @map("product_len")
  sawLength      Decimal   @map("saw_length")
  fysiekeLengte  Decimal   @map("fysieke_lengte")
  materiaal      String
  diameter       Decimal
  werkstukLengte Decimal   @map("werkstuk_lengte")
  steekbreedte   Decimal
  vlakToeslag    Decimal   @map("vlak_toeslag")
  machine        String
  priority       Int?
  rush           Boolean   @default(false)
  // open → in_progress → done (afgeboekt) of geannuleerd. Alleen open en
  // in_progress houden materiaal vast; zie services/voorraad.ts.
  status         String    @default("open")
  restLengteMm   Decimal?  @map("rest_lengte_mm")
  /// Materiaalselectie (2026-10-09): wat er uit deze staaf gezaagd wordt,
  /// [{ lengteMm, stuks }] — laderstangen, of zonder lader één per stuk.
  stangen        Json?
  /// De rest van de staaf gaat bij het afboeken mee als schroot: bij het
  /// kiezen besloten dat er niets meer mee te doen is. `sawLength` is dan de
  /// hele vrije lengte, zodat niemand anders er intussen op rekent.
  restAfboeken   Boolean   @default(false) @map("rest_afboeken")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  artikel Article? @relation(fields: [artikelId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([artikelId])
  @@index([offerteRegelId])
  // "Wat ligt er vast op deze staaf" filtert altijd op staaf én status.
  @@index([barId, status])
  @@map("zaag_reserveringen")
}

model Todo {
  id             String       @id @default(uuid())
  title          String
  dueDate        DateTime?    @map("due_date")
  priority       TodoPriority @default(normal)
  done           Boolean      @default(false)
  completedAt    DateTime?    @map("completed_at")
  // Waar deze todo over gaat. Een losse todo heeft dit niet; een todo die het
  // programma zelf aanmaakt wel, zodat de lijst er een knop naast kan zetten
  // die de bijbehorende handeling opent in plaats van alleen een zin te tonen.
  soort          String? // 'materiaal_selecteren' | 'bestellen'
  projectId      String?      @map("project_id")
  artikelId      String?      @map("artikel_id")
  offerteRegelId String?      @map("offerte_regel_id")

  createdByUserId String    @map("created_by_user_id")
  claimedByUserId String?   @map("claimed_by_user_id")
  claimedAt       DateTime? @map("claimed_at")
  calendarEventId String?   @map("calendar_event_id")
  notifyOnDue     Boolean   @default(false) @map("notify_on_due")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User  @relation("TodoCreatedBy", fields: [createdByUserId], references: [id])
  claimedBy User? @relation("TodoClaimedBy", fields: [claimedByUserId], references: [id])

  @@index([done, dueDate])
  @@index([soort, done])
  @@index([projectId])
  @@map("todos")
}

// ── Mail-import ───────────────────────────────────────────────────────────────
// Zie features/60-mail-import.md. Eén rij per binnengehaalde mail, ongeacht of
// hij gesleept is (fase 1) of door de poller opgehaald (fase 2). Bestaat vooral
// voor idempotentie en als audit-trail: waarom stelde de matcher dit voor.

/// Eén meting van het inlezen van een mail.
///
/// Bestaat om de wachttijd te kunnen voorspellen uit wat er hier écht gebeurt,
/// in plaats van uit een aanname. Bestandsgrootte bleek een zwakke maatstaf
/// (een pdf van 1,1 MB uitlezen kost 24-243 ms); wat telt is hoeveel tekst en
/// hoeveel gescande pagina's er naar het model gaan, en of de controlelezing
/// meedraait. Die kenmerken staan er daarom bij, zodat de voorspelling later
/// verfijnd kan worden zonder opnieuw te moeten meten.
model IngestRun {
  id           String   @id @default(uuid())
  mailImportId String?  @map("mail_import_id")
  /// 'drop' bij het inslepen, 'opnieuw' bij een herlezing.
  soort        String
  bytes        Int
  bijlagen     Int
  /// Aantal tekens dat uit de pdf's kwam en dus naar het model ging.
  tekens       Int
  /// Bijlagen die als afbeelding meegingen omdat er geen tekstlaag in zat.
  scans        Int
  aiGebruikt   Boolean  @map("ai_gebruikt")
  controle     Boolean
  /// Gemeten duur van begin tot eind, in milliseconden.
  duurMs       Int      @map("duur_ms")
  gelukt       Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ingest_runs")
}

model MailImport {
  id            String    @id @default(uuid())
  source        String
  messageId     String?   @map("message_id")
  // Idempotentie-sleutel. Het internet message-id als de mail er een draagt,
  // anders een hash over afzender + onderwerp + datum. Altijd gevuld, altijd
  // uniek — zonder dit maakt de poller uit fase 2 bij elke herstart dezelfde
  // projecten opnieuw aan.
  dedupeKey     String    @unique @map("dedupe_key")
  afzenderNaam  String?   @map("afzender_naam")
  afzenderEmail String?   @map("afzender_email")
  onderwerp     String
  ontvangenOp   DateTime? @map("ontvangen_op")
  bodyText      String    @default("") @map("body_text")
  bodyHtmlPath  String?   @map("body_html_path")
  bijlagen      Json      @default("[]")
  // Uitkomst van de afzender-resolutie (§3.2): direct, doorgestuurd of onbekend.
  resolutie     Json?
  relatieId     String?   @map("relatie_id")
  // Het contact bij die relatie waar de mail vandaan kwam, als het adres te
  // herleiden is. Gaat bij het koppelen mee naar het project.
  contactId     String?   @map("contact_id")
  intent        String    @default("onbekend")
  // Wat de extractie voorstelde — bewaard zodat achteraf te zien is waarom een
  // regel verkeerd gematcht werd.
  kandidaten    Json      @default("[]")
  // Hoe de extractie ging: welk model meelas en hoe zeker het resultaat is.
  // Zie apps/api/src/services/certainty.ts.
  extractie     Json?
  // Wat er om de regels heen stond: het ordernummer van de klant en de
  // gevraagde leverdatum. Gaat bij het koppelen mee naar het project.
  klantRef      String?   @map("klant_ref")
  leverdatum    DateTime?
  status        String    @default("nieuw")
  projectId     String?   @map("project_id")
  foutmelding   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([relatieId])
  @@map("mail_imports")
}

// Geleerde koppeling tussen het artikelnummer van een klant en het onze.
// Wordt gevuld doordat iemand in het reviewscherm een match corrigeert; dat is
// wat de matcher over een stuk of twintig mails van middelmatig naar goed brengt.
model ArticleAlias {
  id          String   @id @default(uuid())
  relatieId   String   @map("relatie_id")
  externalRef String   @map("external_ref")
  articleId   String   @map("article_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")

  @@unique([relatieId, externalRef])
  @@index([articleId])
  @@map("article_aliases")
}

/// Eén keer automatisch plannen (2026-10-08): wat er veranderde, met de oude
/// waarden erbij, zodat het in zijn geheel terug kan. Ongedaan maken gaat alleen
/// van nieuw naar oud — een oudere terugzetten onder een nieuwere zou die
/// nieuwere half laten staan.
model PlanningHerberekening {
  id           String    @id @default(uuid())
  /// Waarom er gerekend werd: "ORD-… vrijgegeven", "Werkbord: … hoger gezet".
  aanleiding   String
  door         String
  op           DateTime  @default(now())
  /// [{ stapId, projectId, orderId, oud: {…}, nieuw: {…} }]
  wijzigingen  Json
  /// Wat de melding liet zien, om hem later terug te lezen.
  samenvatting Json?
  ongedaanOp   DateTime? @map("ongedaan_op")
  ongedaanDoor String?   @map("ongedaan_door")

  @@index([op(sort: Desc)])
  @@map("planning_herberekeningen")
}
